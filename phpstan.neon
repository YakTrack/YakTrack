includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/

    excludePaths:
        - */node_modules/*
        - */vendor/*
        - */storage/*
        - */bootstrap/cache/*

    ignoreErrors:
        # Ignore collection method calls that exist on custom collections but PHPStan doesn't understand
        - '#Call to an undefined method.*Collection.*::(totalDurationInSeconds|totalDurationInHours|totalDurationForHumans|totalValueInSeconds|sessionsThisWeek)\(\)#'
        # Ignore higher order collection proxy issues with model attributes
        - '#Access to an undefined property.*HigherOrderCollectionProxy.*::\$(durationInSeconds|durationInHours|is_billable)#'
        # Ignore model method calls that exist but PHPStan doesn't understand
        - '#Call to an undefined method.*Model::isThisWeek\(\)#'
        - '#Call to an undefined method.*HigherOrderCollectionProxy.*::valueInSeconds\(\)#'
        # Ignore property access on models in collections
        - '#Access to an undefined property.*Model::\$(sessions|totalDurationForHumans|totalDurationInSprintForHumans|is_billable|tasks)#'
        # Ignore property access on specific model classes
        - '#Access to an undefined property App\\Models\\Sprint::\$totalDurationForHumans#'
        - '#Access to an undefined property App\\Models\\Task::\$totalDurationInSprintForHumans#'
        # Ignore custom collection return type issues - these are intentional design choices
        - '#Return type \(App\\Models\\Collections\\.*Collection\) of method App\\Models\\.*::newCollection\(\) should be compatible with return type \(Illuminate\\Database\\Eloquent\\Collection.*\) of method Illuminate\\Database\\Eloquent\\Model::newCollection\(\)#'
        # Ignore template type resolution issues in Collection operations
        - '#Unable to resolve the template type T(Key|Value) in call to function collect#'
        - '#Unable to resolve the template type TMake(Key|Value) in call to method static method.*Collection.*::make\(\)#'
        - '#contains unresolvable type#'
        # Ignore pagination generic type issues
        - '#Generic type .*LengthAwarePaginator.* does not specify all template types#'
        - '#Type .*Session.* in generic type .*LengthAwarePaginator.* is not subtype of template type TKey#'
        # Ignore model appends property issues for properties with valid accessors
        - "#Property 'isRunning' does not exist in model#"